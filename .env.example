# Copy to .env for local development. In Coolify, set these as environment variables.

# development (default) | production
APP_ENV=development

# Required in production: at least 32 random characters.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Required in production: the public address, used to build links in emails.
APP_BASE_URL=http://localhost:5050

# Optional. Default: SQLite at instance/homeinv.db
# DATABASE_URL=sqlite:////data/homeinv.db

# Email. Without Mailjet keys, development prints emails to the console instead.
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Home Inventory

# Number of proxies in front of the app (production on Coolify: Cloudflare Tunnel -> Traefik = 2).
# PROXY_HOPS=0
